{
  "name": "thumbnail-rush",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-questions": "tsx scripts/generate-questions.ts",
    "generate-words": "tsx scripts/generate-search-words.ts"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "dotenv": "^16.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  },
  "engines": { "node": ">=20" }
}
